# =============================================================================
# RigForge Production & Docker Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Django Security & Host Settings
# -----------------------------------------------------------------------------
# Set a strong, unique secret key for production deployments
DJANGO_SECRET_KEY=rigforge-production-super-secret-key-change-me

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated allowed hostnames (add your real domain here)
ALLOWED_HOSTS=localhost,127.0.0.1,web,your_domain.com,www.your_domain.com

# Comma-separated trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://your_domain.com,https://your_domain.com

# Database path (defaults to /app/data/db.sqlite3 inside Docker container)
SQLITE_DB_PATH=/app/data/db.sqlite3

# Gunicorn worker count (typically 2-4 workers per CPU core)
GUNICORN_WORKERS=3

# -----------------------------------------------------------------------------
# AI Visualizer & Fallback Queue API Keys
# -----------------------------------------------------------------------------
# If keys are left empty, users can enter keys dynamically in the UI (stored in browser localStorage)
# or RigForge will default to the free Pollinations.ai FLUX.1 Neural Studio engine.

# Google Gemini / Imagen 3 (https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI ChatGPT / DALL-E 3 (https://platform.openai.com/)
OPENAI_API_KEY=

# Groq Hardware Intelligence (https://console.groq.com/)
GROQ_API_KEY=

# Anthropic Claude 3.5 Sonnet (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Preferred default provider ('pollinations', 'gemini', 'openai', 'groq', 'claude')
AI_RENDER_PROVIDER=pollinations
